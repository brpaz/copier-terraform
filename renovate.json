{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":automergeMinor",
    ":prConcurrentLimit10"
  ],
  "github-actions": {
    "managerFilePatterns": [
      "/(^|/)\\.github/workflows/[^/]+\\.ya?ml$/"
    ]
  },
  "labels": ["dependencies"],
  "reviewers": ["brpaz"],
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "enabled": true,
    "labels": ["security"]
  },
  "osvVulnerabilityAlerts": true,
  "packageRules": [
    {
      "description": "Group infrastructure (Terraform/Ansible) updates",
      "matchManagers": ["terraform", "ansible-galaxy", "pip_requirements"],
      "groupName": "infrastructure"
    },
    {
      "matchManagers": ["github-actions"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "github actions"
    }
  ]
}
